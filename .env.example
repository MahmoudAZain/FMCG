# El-Gomala — environment configuration
# Copy to .env.local and fill from the `supabase start` output.
# Never commit .env.local.

# ---------------------------------------------------------------------------
# Public — safe in the browser. Row Level Security is the boundary, not secrecy.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Server only — never expose these to the browser.
#
# SUPABASE_SERVICE_ROLE_KEY bypasses every Row Level Security policy. It is read
# only through serverEnv() in src/lib/env.ts, which is imported by exactly one
# module (src/lib/supabase/service.ts), guarded with `server-only`. If this key
# reaches a client bundle, every isolation guarantee in the system is void.
#
# In production these are set with `wrangler secret put`, not in a file.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
