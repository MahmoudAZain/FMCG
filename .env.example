# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Pooled connection string, used by the app at runtime. Serverless functions
# open a lot of short-lived connections, so this MUST be the pooled/pgbouncer
# URL from your provider (Vercel Postgres, Neon, Supabase, ...) or you will hit
# "too many connections" errors under load.
DATABASE_URL="postgresql://user:password@host:5432/dbname?pgbouncer=true&connection_limit=1"

# Direct (unpooled) connection string, used only for migrations.
# Migrations cannot run through a connection pooler.
# Neon/Vercel call this DATABASE_URL_UNPOOLED or POSTGRES_URL_NON_POOLING.
# If your provider has no separate direct URL, set this to the same value as DATABASE_URL.
DIRECT_URL="postgresql://user:password@host:5432/dbname"

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Required. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# Local development only. On Vercel, leave this UNSET — NextAuth infers the URL
# from VERCEL_URL, which keeps preview deployments working. Set it explicitly
# only if you serve the app from a custom domain and sign-in redirects misbehave.
NEXTAUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Vercel Blob token for product photo uploads (Vercel dashboard -> Storage -> Blob).
# Automatically injected on Vercel once a Blob store is connected to the project.
BLOB_READ_WRITE_TOKEN=""

# ---------------------------------------------------------------------------
# Seeding (used only by `npm run seed`)
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL="admin@yourcompany.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"
